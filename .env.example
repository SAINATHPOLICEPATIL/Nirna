# Copy to .env and fill in values. Never commit real secrets.

# --- Neon (hosted Postgres) ---
# Do NOT put these here. `neon env pull --file .env.local` writes them to .env.local (gitignored):
#   DATABASE_URL           pooled (app traffic)
#   DATABASE_URL_UNPOOLED  direct (migrations)
# When DATABASE_URL is set, the app uses Neon and automatic schema push is OFF.

# --- Local Docker Postgres (used by tests, `pnpm dev:local`, or when no Neon URL is set) ---
DATABASE_URI=postgres://nirna:CHANGE_ME@localhost:5433/nirna
# Password for the local docker-compose Postgres container (must match DATABASE_URI)
POSTGRES_PASSWORD=CHANGE_ME
# Host port for the local Postgres container
POSTGRES_PORT=5433

# Long random string (e.g. `openssl rand -hex 32`). Used to sign auth tokens.
PAYLOAD_SECRET=CHANGE_ME

# Public base URLs (production: https://nirna.in)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Added in later phases, once providers are chosen ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# EMAIL_FROM=
# EMAIL_SERVER=

# Admin preview / live preview: any long random string (e.g. openssl rand -hex 32).
PREVIEW_SECRET=

# --- Village map (optional; defaults are free and need no key) ---
# Vector style (default: OpenFreeMap "liberty", built on OpenStreetMap data)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Raster tiles used only when WebGL is unavailable (default: OpenStreetMap standard tiles)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
