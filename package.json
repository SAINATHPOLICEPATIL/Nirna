{
  "name": "nirna-digital-village",
  "version": "0.1.0",
  "private": true,
  "description": "NIRNA Digital Village — bilingual (Kannada/English) village platform built with Next.js and Payload CMS",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:local": "cross-env NIRNA_DB_TARGET=local NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "migrate:create": "cross-env NIRNA_DB_DIRECT=1 NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NIRNA_DB_DIRECT=1 NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NIRNA_DB_DIRECT=1 NODE_OPTIONS=--no-deprecation payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed:local": "cross-env NIRNA_DB_TARGET=local NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "leaflet": "1.9.4",
    "maplibre-gl": "5.24.0",
    "next": "16.4.1",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-leaflet": "5.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "28.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  }
}
